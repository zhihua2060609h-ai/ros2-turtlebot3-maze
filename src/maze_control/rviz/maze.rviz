Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: odom
    Frame Rate: 20
    Background Color: 30; 35; 45
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.5
      Plane Cell Count: 30
    - Class: rviz_default_plugins/RobotModel
      Name: Burger
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Durability Policy: Transient Local
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/LaserScan
      Name: Lidar
      Enabled: true
      Topic:
        Value: /scan
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        Depth: 5
      Size (m): 0.03
      Style: Points
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: false
    - Class: rviz_default_plugins/Path
      Name: Trajectory
      Enabled: true
      Topic:
        Value: /trajectory
      Color: 0; 210; 255
      Line Style: Lines
      Line Width: 0.025
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Top View
      Scale: 32
      X: 2.5
      Y: 2.5
Window Geometry:
  X: 660
  Y: 27
  Width: 620
  Height: 650
